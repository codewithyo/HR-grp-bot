# =========================================================
# Telegram Bot Configuration
# =========================================================

# Required: Telegram API credentials
API_ID=
API_HASH=
BOT_TOKEN=

# Required: Your Telegram user ID (get it from @userinfobot)
OWNER_ID=
# Optional: Log group ID (leave 0 for auto-detect)
LOG_GROUP_ID=

# Optional: Backup chat ID (defaults to LOG_GROUP_ID)
BACKUP_CHAT_ID=0

# =========================================================
# MongoDB Configuration (Optional but Recommended)
# =========================================================

# MongoDB Connection String
# For MongoDB Atlas (Cloud):
#   mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
# For Local MongoDB:
#   mongodb://localhost:27017
# For Local MongoDB with Auth:
#   mongodb://username:password@localhost:27017/?authSource=admin

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?appName=Cluster0

# Database name (will be created automatically if doesn't exist)
MONGODB_DB_NAME=hr_moderation_bot

# =========================================================
# Server Configuration
# =========================================================

# Port for webhook and health check endpoints
PORT=8000

# Optional: Storage path for JSON backups
STORAGE_PATH=/data/modbot

# Optional: Webhook URL (usually auto-detected)
WEBHOOK_URL=https://your-domain.com

# Optional: Enable debug notifications to owner
OWNER_DEBUG_NOTIFICATIONS=0

# =========================================================
# Notes
# =========================================================

# MongoDB Setup:
# 1. Quick Start (MongoDB Atlas Cloud):
#    - Sign up at https://www.mongodb.com/cloud/atlas
#    - Create a free cluster
#    - Get connection string: mongodb+srv://user:pass@cluster.mongodb.net
#    - Set MONGODB_URI above
#
# 2. Local Development:
#    - Install MongoDB: https://docs.mongodb.com/manual/installation/
#    - Start MongoDB: mongod
#    - Use: mongodb://localhost:27017
#
# 3. Docker:
#    - docker run -d -p 27017:27017 mongo:latest
#    - Use: mongodb://localhost:27017
#
# Without MongoDB:
# - Leave MONGODB_URI empty or commented out
# - Bot will use JSON files for storage (works but data is lost on restart)
